      "kind": "open_question",
      "source_refs": [
        "user:kigenoggly_source_review"
      ]
    },
    {
      "data": {
        "text": "¿Qué obstáculos enfrentan los roles propietario, operador, destinatario y visitante en los recorridos reales?"
